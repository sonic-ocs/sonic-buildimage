MPATH       := $($(OCS_KVM_OCSV_PLATFORM_MODULE)_SRC_PATH)
DEP_FILES   := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/platform-modules-ocs-kvm.mk $(PLATFORM_PATH)/platform-modules-ocs-kvm.dep
DEP_FILES   += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES   += $(shell git ls-files $(MPATH))

$(OCS_KVM_OCSV_PLATFORM_MODULE)_CACHE_MODE  := GIT_CONTENT_SHA
$(OCS_KVM_OCSV_PLATFORM_MODULE)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(OCS_KVM_OCSV_PLATFORM_MODULE)_DEP_FILES   := $(DEP_FILES)
